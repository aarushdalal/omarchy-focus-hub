def show_main_menu():
    state = load_state()
    cfg = load_config()

    if state and state.get("active"):
        remaining = format_time_remaining(state.get("ends_at", 0) - time.time())
        label = state.get("label", "Focus Session")
        
        options = [
            f"󰄬\t⏳ Status: {remaining} remaining\t{label} in progress",
            "󰓛\t🛑 End Session Now\tStop timer and lift restrictions",
            "󱓞\t➕ Extend Session (+10 mins)\tAdd more focus time",
            "󰐊\t☕ Take a Short Break (5 mins)\tPause and relax",
            "󰐊\t🌴 Take a Long Break (15 mins)\tExtended breather",
            "󰀻\t➕ Allow Current Window\tWhitelist current active app",
            "󰏘\t📱 Manage Allowed Apps\tView or edit permitted apps",
            "🌐\t📖 Manage Permitted Websites (Whitelist)\tAlways allowed study sites",
            "⛔\t🚫 Manage Restricted Websites (Blacklist)\tBlocked distracting sites",
            "󰂚\t🔔 Toggle Sound Alerts\tToggle sound chimes on/off"
        ]
        
        sel = menu_select(f"Study Focus Active ({remaining})", options, width=580)
        if not sel:
            return
            
        action = sel.split("\t")[0]
        if "End Session Now" in action:
            stop_existing_daemon()
            notify("🛑 Session Ended", "Focus session stopped. All tabs and apps unlocked.", glyph="󰓛")
        elif "Extend Session" in action:
            extend_session(10)
        elif "Take a Short Break" in action:
            start_session(5, session_type="break", label="Short Break")
        elif "Take a Long Break" in action:
            start_session(15, session_type="break", label="Long Break")
        elif "Allow Current Window" in action:
            allow_current_window()
        elif "Manage Allowed Apps" in action:
            manage_allowed_apps_menu()
        elif "Manage Permitted Websites" in action:
            manage_permitted_websites_menu()
        elif "Manage Restricted Websites" in action:
            manage_blocked_websites_menu()
        elif "Toggle Sound Alerts" in action:
            cfg["sound_alerts"] = not cfg.get("sound_alerts", True)
            save_config(cfg)
            status = "Enabled" if cfg["sound_alerts"] else "Disabled"
            notify("Sound Alerts", f"Sound chimes are now {status}.", glyph="󰂚")
            
    else:
        sound_status = "Enabled" if cfg.get("sound_alerts", True) else "Disabled"
        options = [
            "󰑴\tPomodoro Session (25 mins)\tClassic focus sprint + short break",
            "󰡄\tDeep Study Sprint (45 mins)\tIdeal for lectures, chapters & solving",
            "󰌌\tIntense Marathon (60 mins)\tOne solid hour of distraction-free work",
            "󰒲\tCustom Focus Timer...\tSet your own duration in minutes",
            "󰐊\tQuick Break (5 mins)\tShort rest before starting next session",
            "󰀻\t📱 Manage Allowed Study Apps\tConfigure whitelisted applications",
            "🌐\t📖 Manage Permitted Websites (Whitelist)\tAllowed study websites & portals",
            "⛔\t🚫 Manage Restricted Websites (Blacklist)\tDistracting sites to block",
            f"󰂚\tToggle Sound Chimes ({sound_status})\tTurn completion and warning sounds on/off"
        ]
        
        sel = menu_select("Study & Focus Mode", options, width=600)
        if not sel:
            return
            
        action = sel.split("\t")[0]
        if "Pomodoro Session" in action:
            start_session(25, session_type="study", label="Pomodoro Focus")
        elif "Deep Study Sprint" in action:
            start_session(45, session_type="study", label="Deep Study Sprint")
        elif "Intense Marathon" in action:
            start_session(60, session_type="study", label="Intense Marathon")
        elif "Custom Focus Timer" in action:
            val = menu_input("Enter study duration in minutes (e.g. 30, 90):", width=460)
            if val:
                try:
                    mins = float(val)
                    if mins > 0:
                        start_session(mins, session_type="study", label=f"Custom Focus ({int(mins)}m)")
                    else:
                        notify("Invalid Time", "Please enter a positive number of minutes.", glyph="󰢌")
                except ValueError:
                    notify("Invalid Input", "Please enter a valid number.", glyph="󰢌")
        elif "Quick Break" in action:
            start_session(5, session_type="break", label="Quick Break")
        elif "Manage Allowed Study Apps" in action:
            manage_allowed_apps_menu()
        elif "Manage Permitted Websites" in action:
            manage_permitted_websites_menu()
        elif "Manage Restricted Websites" in action:
            manage_blocked_websites_menu()
        elif "Toggle Sound Chimes" in action:
            cfg["sound_alerts"] = not cfg.get("sound_alerts", True)
            save_config(cfg)
            status = "Enabled" if cfg["sound_alerts"] else "Disabled"
            notify("Sound Alerts", f"Sound chimes are now {status}.", glyph="󰂚")

def main():
    if len(sys.argv) > 1:
        cmd = sys.argv[1]
        if cmd == "daemon-exec":
            if len(sys.argv) >= 5:
                duration = int(sys.argv[2])
                stype = sys.argv[3]
                label = sys.argv[4]
                paused_study = None
                if "--paused-study" in sys.argv:
                    idx = sys.argv.index("--paused-study")
                    if idx + 1 < len(sys.argv):
                        try:
                            paused_study = json.loads(sys.argv[idx + 1])
                        except Exception:
                            pass
                run_daemon(duration, session_type=stype, label=label, paused_study=paused_study)
            return
        elif cmd in ["menu", "popup"]:
            show_main_menu()
            return
        elif cmd == "start":
            mins = float(sys.argv[2]) if len(sys.argv) > 2 else 25
            label = sys.argv[3] if len(sys.argv) > 3 else "Study Focus"
            start_session(mins, session_type="study", label=label)
            return
        elif cmd == "break":
            mins = float(sys.argv[2]) if len(sys.argv) > 2 else 5
            label = sys.argv[3] if len(sys.argv) > 3 else "Break"
            start_session(mins, session_type="break", label=label)
            return
        elif cmd == "resume":
            resume_study_session()
            return
        elif cmd == "trigger-reward":
            mins = int(sys.argv[2]) if len(sys.argv) > 2 else 25
            lbl = sys.argv[3] if len(sys.argv) > 3 else "Pomodoro Focus"
            record_completion_event(mins * 60, lbl)
            notify("🎉 Session Complete!", f"Celebration reward triggered for {lbl} ({mins}m).", glyph="🏆")
            play_sound("complete")
            return
        elif cmd == "stop":
            stop_existing_daemon(clear=True)
            notify("🛑 Session Stopped", "Study focus mode ended.", glyph="󰓛")
            return
        elif cmd == "extend":
            mins = int(sys.argv[2]) if len(sys.argv) > 2 else 10
            extend_session(mins)
            return
        elif cmd == "toggle-strict":
            cfg = load_config()
            cfg["strict_website_whitelist"] = not cfg.get("strict_website_whitelist", False)
            save_config(cfg)
            new_status = "STRICT" if cfg["strict_website_whitelist"] else "STANDARD"
            notify("Website Filter Mode", f"Mode set to: {new_status}", glyph="🔒")
            return
        elif cmd == "toggle-sound":
            cfg = load_config()
            cfg["sound_alerts"] = not cfg.get("sound_alerts", True)
            save_config(cfg)
            status = "Enabled" if cfg["sound_alerts"] else "Disabled"
            notify("Sound Alerts", f"Sound chimes are now {status}.", glyph="󰂚")
            return
        elif cmd == "reset-stats":
            stats_file = CONFIG_DIR / "study-stats.json"
            today = time.strftime("%Y-%m-%d")
            stats = {}
            if stats_file.exists():
                try:
                    stats = json.load(open(stats_file))
                except Exception:
                    pass
            stats[today] = {"minutes": 0, "sessions": 0}
            with open(stats_file, "w") as f:
                json.dump(stats, f, indent=2)
            notify("Stats Reset", "Today's focus time and sprints reset.", glyph="󰄬")
            return
        elif cmd == "status":
            state = load_state()
            if state and state.get("active"):
                rem = format_time_remaining(state.get("ends_at", 0) - time.time())
                print(f"Active: {state.get('label')} ({rem} remaining)")
            else:
                print("Inactive")
            return
        elif cmd in ["allow-current", "allow-active"]:
            allow_current_window()
            return
        elif cmd == "allow":
            if len(sys.argv) > 2:
                add_allowed_app(sys.argv[2])
            return
        elif cmd == "disallow":
            if len(sys.argv) > 2:
                remove_allowed_app(sys.argv[2])
            return
        elif cmd in ["allow-site", "allow-domain"]:
            if len(sys.argv) > 2:
                add_allowed_domain(sys.argv[2])
            return
        elif cmd in ["disallow-site", "disallow-domain"]:
            if len(sys.argv) > 2:
                remove_allowed_domain(sys.argv[2])
            return
        elif cmd == "block-domain":
            if len(sys.argv) > 2:
                add_blocked_domain(sys.argv[2])
            return
        elif cmd == "unblock-domain":
            if len(sys.argv) > 2:
                remove_blocked_domain(sys.argv[2])
            return
        elif cmd == "help" or cmd == "--help" or cmd == "-h":
            print("""Usage: omarchy-study-focus [command]

Commands:
  menu                  Open the interactive Omarchy popup menu (default)
  start <minutes> [tag] Start a study session with tab & app whitelist enforcement
  break <minutes> [tag] Start a break timer
  stop                  Stop active session and remove restrictions
  status                Show current timer status
  allow-current         Whitelist the currently active window
  allow <pattern>       Add app pattern to whitelist (e.g. 'vlc*')
  disallow <pattern>    Remove app pattern from whitelist
  allow-site <domain>   Add website to permitted whitelist (e.g. 'missionjeet.in')
  disallow-site <dom>   Remove website from permitted whitelist
  block-domain <domain> Add website to restricted blacklist (e.g. 'reddit.com')
  unblock-domain <dom>  Remove website from restricted blacklist
""")
            return

    show_main_menu()

if __name__ == "__main__":
    main()
