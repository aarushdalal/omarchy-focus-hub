def manage_permitted_websites_menu():
    while True:
        cfg = load_config()
        domains = cfg.get("allowed_domains", DEFAULT_ALLOWED_DOMAINS)
        strict_mode = cfg.get("strict_website_whitelist", False)
        mode_label = "Enabled (Strict Whitelist Only)" if strict_mode else "Disabled (Standard Filter)"

        options = [
            "󰏫\t➕ Add Permitted Website Domain...\tEnter domain like 'coursera.org', 'mit.edu'",
            "󰭌\t➖ Remove Permitted Website\tRemove domain from whitelist",
            f"🔒\tToggle Strict Whitelist Mode ({mode_label})\tOnly permitted websites can be opened",
            "\t🔄 Reset Permitted Websites to Default\tRestore standard study websites",
            "󰌌\t📋 View All Permitted Websites\tDisplay complete permitted websites list",
            "󰌑\t↩ Back to Main Menu\tReturn to focus options"
        ]
        
        sel = menu_select("Permitted Websites (Whitelist)", options, width=600)
        if not sel:
            break
            
        action = sel.split("\t")[0]
        if "➕ Add Permitted Website Domain" in action:
            dom = menu_input("Enter website domain to permit (e.g. khanacademy.org):", width=520)
            if dom:
                add_allowed_domain(dom)
        elif "➖ Remove Permitted Website" in action:
            if not domains:
                notify("Empty List", "Permitted websites list is empty.", glyph="󰢌")
                continue
            rem_options = [f"󰭌\t{d}\tRemove from permitted list" for d in domains]
            rem_options.append("󰌑\tCancel\tKeep permitted")
            rem_sel = menu_select("Select Website to Remove", rem_options, width=540)
            if rem_sel and not "Cancel" in rem_sel:
                dom_to_remove = rem_sel.split("\t")[0]
                remove_allowed_domain(dom_to_remove)
        elif "Toggle Strict Whitelist Mode" in action:
            cfg["strict_website_whitelist"] = not cfg.get("strict_website_whitelist", False)
            save_config(cfg)
            new_status = "STRICT (Only permitted websites allowed)" if cfg["strict_website_whitelist"] else "STANDARD (Blacklisted sites blocked)"
            notify("Website Filter Mode", f"Mode set to: {new_status}", glyph="🔒")
        elif "🔄 Reset Permitted Websites to Default" in action:
            cfg["allowed_domains"] = DEFAULT_ALLOWED_DOMAINS.copy()
            save_config(cfg)
            notify("List Reset", "Permitted websites reset to defaults.", glyph="󰄬")
        elif "📋 View All Permitted Websites" in action:
            view_options = [f"󰄬\t{d}\tAlways permitted during study" for d in domains]
            view_options.append("󰌑\tClose\tDismiss list")
            menu_select("Permitted Websites (Whitelist)", view_options, width=540)
        elif "↩ Back to Main Menu" in action:
            break

