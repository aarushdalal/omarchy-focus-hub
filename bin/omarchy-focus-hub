def ensure_dirs():
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    RUNTIME_DIR.mkdir(parents=True, exist_ok=True)

def load_config():
    ensure_dirs()
    if not CONFIG_FILE.exists():
        save_config(DEFAULT_CONFIG)
        return DEFAULT_CONFIG.copy()
    try:
        with open(CONFIG_FILE, "r") as f:
            data = json.load(f)
            for k, v in DEFAULT_CONFIG.items():
                if k not in data:
                    data[k] = v
            return data
    except Exception:
        return DEFAULT_CONFIG.copy()

def save_config(cfg):
    ensure_dirs()
    with open(CONFIG_FILE, "w") as f:
        json.dump(cfg, f, indent=2)

def load_raw_state():
    if not STATE_FILE.exists():
        return None
    try:
        with open(STATE_FILE, "r") as f:
            return json.load(f)
    except Exception:
        return None

def load_state():
    if not STATE_FILE.exists():
        return None
    try:
        with open(STATE_FILE, "r") as f:
            state = json.load(f)
            if state.get("active") and state.get("ends_at", 0) > time.time():
                return state
            if state.get("active") and state.get("ends_at", 0) <= time.time():
                # The daemon owns expiry and completion; readers never remove
                # its authoritative deadline while it is processing expiry.
                return None
            return None
    except Exception:
        return None

def save_state(state):
    ensure_dirs()
    import tempfile
    descriptor, temporary = tempfile.mkstemp(prefix=".state-", dir=STATE_FILE.parent)
    try:
        with os.fdopen(descriptor, "w") as f:
            json.dump(state, f, indent=2); f.flush(); os.fsync(f.fileno())
        os.replace(temporary, STATE_FILE)
    finally:
        Path(temporary).unlink(missing_ok=True)

def record_session_completion(duration_seconds, label):
    stats_file = CONFIG_DIR / "study-stats.json"
    today = time.strftime("%Y-%m-%d")
    stats = {}
    if stats_file.exists():
        try:
            with open(stats_file, "r") as f:
                stats = json.load(f)
        except Exception:
            stats = {}
    if today not in stats:
        stats[today] = {"minutes": 0, "sessions": 0}
    mins_added = max(1, int(round(duration_seconds / 60.0)))
    stats[today]["minutes"] = stats[today].get("minutes", 0) + mins_added
    stats[today]["sessions"] = stats[today].get("sessions", 0) + 1
    try:
        with open(stats_file, "w") as f:
            json.dump(stats, f, indent=2)
    except Exception:
        pass

def record_completion_event(duration_seconds, label):
    ensure_dirs()
    event_file = RUNTIME_DIR / "completion.json"
    mins = max(1, int(round(duration_seconds / 60.0)))
    event = {
        "timestamp": time.time(),
        "minutes": mins,
        "label": label,
        "total_seconds": duration_seconds
    }
    try:
        with open(event_file, "w") as f:
            json.dump(event, f, indent=2)
    except Exception:
        pass

def clear_state(only_if_pid=None):
    if PID_FILE.exists():
        try:
            with open(PID_FILE, "r") as f:
                cur_pid = int(f.read().strip())
            if only_if_pid is not None and cur_pid != only_if_pid:
                return
        except Exception:
            pass
        try:
            PID_FILE.unlink()
        except OSError:
            pass
    if STATE_FILE.exists():
        try:
            STATE_FILE.unlink()
        except OSError:
            pass

def format_time_remaining(seconds):
    seconds = max(0, int(seconds))
    mins = seconds // 60
    secs = seconds % 60
    if mins >= 60:
        hrs = mins // 60
        mins = mins % 60
        return f"{hrs}h {mins}m {secs}s"
    elif mins > 0:
        return f"{mins}m {secs:02d}s"
    else:
        return f"{secs}s"

def notify(headline, description="", glyph="󰑴", urgency="normal"):
    cmd = ["omarchy-notification-send", "-g", glyph, "-u", urgency, headline]
    if description:
        cmd.append(description)
    try:
        subprocess.run(cmd, check=False)
    except Exception:
        try:
            subprocess.run(["notify-send", headline, description], check=False)
        except Exception:
            pass

def play_sound(sound_name):
    cfg = load_config()
    if not cfg.get("sound_alerts", True):
        return
    custom_reward = str(Path.home() / ".config/omarchy/plugins/daemon0.study-focus/sounds/reward.wav")
    sound_map = {
        "start": "/usr/share/sounds/freedesktop/stereo/service-login.oga",
        "complete": custom_reward if os.path.exists(custom_reward) else "/usr/share/sounds/freedesktop/stereo/complete.oga",
        "break_start": "/usr/share/sounds/freedesktop/stereo/bell.oga",
        "blocked": "/usr/share/sounds/freedesktop/stereo/dialog-warning.oga"
    }
    sound_path = sound_map.get(sound_name, "")
    if sound_path and os.path.exists(sound_path):
        for player in ["pw-play", "paplay", "canberra-gtk-play", "aplay"]:
            if subprocess.run(["which", player], capture_output=True).returncode == 0:
                if player == "canberra-gtk-play":
                    subprocess.Popen([player, "-f", sound_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                else:
                    subprocess.Popen([player, sound_path], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
                break

# ==============================================================================
# LOCAL HTTP STATUS & NOTIFICATION SERVER
# ==============================================================================

class StatusHandler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        state = load_state()
        cfg = load_config()
        active = bool(state and state.get("active"))
        stype = state.get("type", "study") if state else "none"
        
        response = {
            "active": active,
            "type": stype,
            "ends_at": state.get("ends_at", 0) if state else 0,
            "strict_website_whitelist": cfg.get("strict_website_whitelist", False),
            "allowed_domains": cfg.get("allowed_domains", DEFAULT_ALLOWED_DOMAINS),
            "blocked_domains": cfg.get("blocked_domains", DEFAULT_BLOCKED_DOMAINS)
        }
        
        body = json.dumps(response).encode("utf-8")
        self.send_response(200)
        self.send_header("Content-Type", "application/json")
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def do_POST(self):
        if self.path == "/notify":
            content_length = int(self.headers.get("Content-Length", 0))
            body = self.rfile.read(content_length).decode("utf-8", errors="ignore")
            try:
                data = json.loads(body)
                headline = data.get("headline", "⛔ Website Restricted")
                description = data.get("description", "Closed restricted website tab.")
                glyph = data.get("glyph", "󰅶")
                urgency = data.get("urgency", "critical")
                notify(headline, description, glyph=glyph, urgency=urgency)
                play_sound("blocked")
            except Exception:
                pass

            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Access-Control-Allow-Origin", "*")
            self.end_headers()
            self.wfile.write(b'{"status": "ok"}')
        else:
            self.send_response(404)
            self.end_headers()

    def do_OPTIONS(self):
        self.send_response(200)
        self.send_header("Access-Control-Allow-Origin", "*")
        self.send_header("Access-Control-Allow-Methods", "GET, POST, OPTIONS")
        self.send_header("Access-Control-Allow-Headers", "Content-Type")
        self.end_headers()

    def log_message(self, format, *args):
        pass

def start_http_status_server():
    try:
        server = http.server.ThreadingHTTPServer(("127.0.0.1", 29876), StatusHandler)
        t = threading.Thread(target=server.serve_forever, daemon=True)
        t.start()
        return server
    except Exception:
        return None

# ==============================================================================
# WINDOW & TAB ENFORCEMENT
# ==============================================================================

def get_active_window():
    try:
        res = subprocess.run(["hyprctl", "activewindow", "-j"], capture_output=True, text=True)
        if res.returncode == 0 and res.stdout.strip():
            return json.loads(res.stdout)
    except Exception:
        pass
    return None

def get_all_windows():
    try:
        res = subprocess.run(["hyprctl", "clients", "-j"], capture_output=True, text=True)
        if res.returncode == 0 and res.stdout.strip():
            return json.loads(res.stdout)
    except Exception:
        pass
    return []

def get_process_comm(pid):
    try:
        with open(f"/proc/{pid}/comm", "r") as f:
            return f.read().strip().lower()
    except Exception:
        return ""

_last_termination = {}
_close_attempts = {}

def normalize_app_str(s):
    if not s:
        return ""
    return re.sub(r'[^a-zA-Z0-9]', '', str(s).lower())

def get_domain_keywords(domain):
    d = str(domain).strip().lower()
    if not d:
        return set()
    if "://" in d:
        d = d.split("://", 1)[1]
    d = d.split("/", 1)[0].split(":", 1)[0].strip()
    d = d.replace("*", "").strip(".")
    if not d:
        return set()
    keywords = {d}
    if d.startswith("www."):
        clean = d[4:]
        keywords.add(clean)
    else:
        clean = d
    parts = clean.split(".")
    if len(parts) >= 2:
        if parts[-1] in {"in", "uk", "au", "br", "jp"} and len(parts) >= 3 and parts[-2] in {"co", "com", "org", "gov", "edu"}:
            base = parts[-3]
        else:
            base = parts[-2] if len(parts) >= 2 else parts[0]
        if len(base) >= 3:
            keywords.add(base)
    elif len(clean) >= 3:
        keywords.add(clean)

    if "github" in clean:
        keywords.update(["github", "github.com", "github.io", "githubusercontent", "gist.github", "api.github", "raw.githubusercontent"])
    elif "youtube" in clean or "youtu.be" in clean:
        keywords.update(["youtube", "youtube.com", "youtu.be", "music.youtube", "ytimg", "googlevideo", "studio.youtube", "youtube-nocookie"])
    elif "stackoverflow" in clean:
        keywords.update(["stackoverflow", "stack overflow", "stackexchange"])
    elif "chatgpt" in clean or "openai" in clean:
        keywords.update(["chatgpt", "openai"])
    elif "google" in clean:
        keywords.update(["google", "google.com", "google.co.in"])

    return keywords

def kill_forbidden_binaries(blocked_binaries):
    # One same-user process snapshot. Exact executable identity and SIGTERM
    # preserve unrelated command lines and application save handling.
    cfg = load_config()
    allowed_apps = cfg.get("allowed_apps", [])
    allowed_norms = {normalize_app_str(a) for a in allowed_apps if a and len(normalize_app_str(a)) >= 3}

    # Filter out allowed apps and immune processes from blocked binaries
    blocked = set()
    for value in blocked_binaries:
        b_low = str(value).lower().strip()
        b_norm = normalize_app_str(b_low)
        if not b_low or b_low in IMMUNE_PROCESSES or b_norm in IMMUNE_PROCESSES:
            continue
        if any(b_norm == an or (len(an) >= 3 and (an in b_norm or b_norm in an)) for an in allowed_norms):
            continue
        blocked.add(b_low)

    now = time.monotonic()
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit(): continue
        pid = int(proc.name)
        if pid == os.getpid() or pid <= 1: continue
        try:
            if proc.stat().st_uid != os.getuid(): continue
            executable = Path(os.readlink(proc / "exe")).name.lower()
            if executable in IMMUNE_PROCESSES: continue
            comm = get_process_comm(pid)
            if comm in IMMUNE_PROCESSES: continue

            norm_exe = normalize_app_str(executable)
            norm_comm = normalize_app_str(comm)

            # Never kill allowed apps
            if any(norm_exe == an or norm_comm == an or (len(an) >= 3 and (an in norm_exe or an in norm_comm or norm_exe in an)) for an in allowed_norms):
                continue

            blocked_norms = {normalize_app_str(b) for b in blocked}
            matches = (executable in blocked) or (comm in blocked) or (norm_exe in blocked_norms) or (norm_comm in blocked_norms)
            if not matches: continue

            stat_line = (proc / "stat").read_text()
            starttime = stat_line.rsplit(")", 1)[1].split()[19]
            identity = (pid, starttime)

            last_attempt, sent_sigterm = _last_termination.get(identity, (0, False))
            elapsed = now - last_attempt

            if not sent_sigterm or elapsed > 10:
                try:
                    os.kill(pid, signal.SIGTERM)
                except OSError:
                    pass
                _last_termination[identity] = (now, True)
            elif elapsed >= 1.5:
                # Stubborn process refused to terminate with SIGTERM -> escalate to SIGKILL
                try:
                    os.kill(pid, signal.SIGKILL)
                except OSError:
                    pass
                _last_termination[identity] = (now, True)
        except (OSError, ValueError, IndexError): continue
    for identity, (sent_time, _) in list(_last_termination.items()):
        if now - sent_time > 60: _last_termination.pop(identity, None)

def is_window_forbidden(win_class, win_initial_class, win_title, allowed_patterns, blocked_patterns, allowed_domains):
    w_class = win_class.lower()
    w_init = win_initial_class.lower()
    w_title = win_title.lower()

    # 1. System essentials are NEVER blocked
    system_allow = [
        "org.omarchy.*",
        "hypr*",
        "zenity*",
        "yad*",
        "rofi*",
        "wofi*",
        "polkit*",
        "xdg-desktop-portal*",
        "foot*",
        "ghostty*",
        "kitty*",
        "alacritty*",
        "wezterm*",
        "antigravity*",
        "agy*"
    ]
    for pattern in system_allow:
        if fnmatch.fnmatch(w_class, pattern.lower()) or fnmatch.fnmatch(w_init, pattern.lower()):
            return False, "system", "none"

    is_browser = any(b in w_class for b in ["brave", "chromium", "chrome", "firefox", "zen"])
    is_pwa = is_browser and ("brave-" in w_class and not w_class.startswith("brave-browser"))

    # Browser Picture-in-Picture windows are never blocked
    if is_browser and any(pip in w_title for pip in ["picture-in-picture", "picture in picture", "pip"]):
        return False, "Browser picture-in-picture", "none"

    # 2. Check if explicitly allowed domain is in title/class (e.g. GitHub, YouTube, etc.)
    # This allows all sub-windows, popups, and tabs of allowed websites!
    w_title_norm = normalize_app_str(w_title)
    for dom in allowed_domains:
        kws = get_domain_keywords(dom)
        for kw in kws:
            if not kw: continue
            kw_norm = normalize_app_str(kw)
            if kw in w_title or kw in w_class or kw in w_init or kw.replace(".", " ") in w_title or (len(kw_norm) >= 4 and kw_norm in w_title_norm):
                return False, f"Permitted domain: {dom}", "none"

    # 3. Whitelist check (Allowed Apps take precedence over Blacklist!)
    w_norm = normalize_app_str(w_class)
    w_init_norm = normalize_app_str(w_init)
    w_class_parts = [normalize_app_str(p) for p in re.split(r'[-_.]', win_class) if len(p) >= 2]

    for pattern in allowed_patterns:
        pat = pattern.strip().lower()
        if not pat:
            continue
        keyword = pat.replace("*", "").strip()
        pat_norm = normalize_app_str(pat)
        if fnmatch.fnmatch(w_class, pat) or fnmatch.fnmatch(w_init, pat):
            return False, "allowed", "none"
        if pat_norm and (pat_norm == w_norm or pat_norm == w_init_norm or pat_norm in w_norm or pat_norm in w_init_norm or (len(w_norm) >= 3 and w_norm in pat_norm)):
            return False, f"Allowed app keyword: {pattern}", "none"
        if pat_norm and any(pat_norm == part or (len(part) >= 3 and part in pat_norm) or (len(pat_norm) >= 3 and pat_norm in part) for part in w_class_parts):
            return False, f"Allowed app component: {pattern}", "none"
        if pat_norm and len(pat_norm) >= 3 and (pat_norm in w_title_norm or w_title_norm.startswith(pat_norm)):
            return False, f"Allowed app title: {pattern}", "none"

    # 4. Blacklist check (Blocked Patterns & Blocked Domains)
    # Suppress any blocked pattern that corresponds to an explicitly allowed domain!
    allowed_kws = set()
    for dom in allowed_domains:
        allowed_kws.update(get_domain_keywords(dom))

    effective_blocked_patterns = []
    for pattern in blocked_patterns:
        pat = pattern.strip().lower()
        if not pat:
            continue
        kw = pat.replace("*", "").strip()
        kw_norm = normalize_app_str(kw)
        if kw and any(kw == ak or kw in ak or ak in kw or (len(kw_norm) >= 3 and (kw_norm in normalize_app_str(ak) or normalize_app_str(ak) in kw_norm)) for ak in allowed_kws if len(ak) >= 3):
            # Explicitly allowed website -> suppress blocked pattern!
            continue
        effective_blocked_patterns.append(pattern)

    for pattern in effective_blocked_patterns:
        pat = pattern.strip().lower()
        keyword = pat.replace("*", "").strip()
        if not keyword:
            continue
        if fnmatch.fnmatch(w_class, pat) or fnmatch.fnmatch(w_init, pat) or keyword in w_class or keyword in w_init:
            return True, f"Blacklisted app: {pattern}", "window"
        if is_browser and keyword in w_title:
            if is_pwa:
                return True, f"Blacklisted PWA: {w_title}", "window"
            else:
                return True, f"Blacklisted Tab: {w_title}", "tab"

    return True, "Not on study whitelist", "window"

def enforce_close_tab_or_window(address, action_type="window", pid=None):
    now = time.time()
    for k in list(_close_attempts.keys()):
        if now - _close_attempts[k]["time"] > 30.0:
            del _close_attempts[k]

    if action_type == "tab":
        # Tab closure inside browser windows is handled by browser extension
        return False

    if action_type == "window":
        target_key = address or (f"pid:{pid}" if pid else None)
        if not target_key:
            return False

        record = _close_attempts.get(target_key, {"count": 0, "first_time": now, "time": now})
        record["count"] += 1
        record["time"] = now
        _close_attempts[target_key] = record

        # 1. Attempt graceful close via Hyprland dispatcher
        if isinstance(address, str) and address.startswith("0x"):
            subprocess.run(["hyprctl", "dispatch", "closewindow", "address:" + address],
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=2)

        # 2. Terminate the process if it's still running, minimizes to tray, or ignores closewindow
        if pid and pid > 1:
            comm = get_process_comm(pid)
            if comm not in IMMUNE_PROCESSES and pid != os.getpid():
                # On first failure / retry (count >= 2 or after 0.5s), send SIGTERM
                if record["count"] >= 2 or now - record["first_time"] >= 0.5:
                    try:
                        os.kill(pid, signal.SIGTERM)
                    except OSError:
                        pass
                # If window stubbornly refuses to close after 1.5 seconds, escalate to SIGKILL
                if now - record["first_time"] >= 1.5 and record["count"] >= 4:
                    try:
                        os.kill(pid, signal.SIGKILL)
                    except OSError:
                        pass
        return True
    return False

# ==============================================================================
# DAEMON LOGIC
# ==============================================================================

def run_daemon(duration_seconds, session_type="study", label="Focus Session", paused_study=None):
    now = time.time()
    ends_at = now + duration_seconds
    pid = os.getpid()

    state = {
        "active": True,
        "type": session_type,
        "label": label,
        "started_at": now,
        "ends_at": ends_at,
        "total_seconds": duration_seconds,
        "pid": pid,
        "paused_study": paused_study
    }
    save_state(state)

    with open(PID_FILE, "w") as f:
        f.write(str(pid))

    def sig_handler(signum, frame):
        clear_state(only_if_pid=pid)
        sys.exit(0)

    signal.signal(signal.SIGTERM, sig_handler)
    signal.signal(signal.SIGINT, sig_handler)

    glyph = "󰑴" if session_type == "study" else "☕"
    formatted_time = format_time_remaining(duration_seconds)
    if session_type == "break":
        if paused_study and paused_study.get("remaining_seconds", 0) > 0:
            p_rem = format_time_remaining(paused_study["remaining_seconds"])
            p_lbl = paused_study.get("label", "Study Session")
            notify(f"☕ {label} Started", f"Break for {formatted_time}. Paused: '{p_lbl}' ({p_rem} remaining).", glyph="☕")
        else:
            notify(f"☕ {label} Started", f"Break duration: {formatted_time}. Enjoy your breather!", glyph="☕")
    else:
        notify(f"🎯 {label} Started", f"Duration: {formatted_time}. Tab & App restrictions active.", glyph=glyph)
    
    play_sound("start" if session_type == "study" else "break_start")

    http_srv = start_http_status_server()

    runtime_dir = os.environ.get("XDG_RUNTIME_DIR", "/run/user/1000")
    his = os.environ.get("HYPRLAND_INSTANCE_SIGNATURE", "")
    sock_path = f"{runtime_dir}/hypr/{his}/.socket2.sock"

    sock = None
    if os.path.exists(sock_path):
        try:
            sock = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            sock.connect(sock_path)
            sock.setblocking(False)
        except Exception:
            sock = None

    last_proc_check = 0
    last_win_check = 0
    blocked_notif_cache = {}

    if session_type == "study":
        cfg = load_config()
        kill_forbidden_binaries(cfg.get("blocked_binaries", DEFAULT_BLOCKED_BINARIES))
        check_and_enforce_windows(
            cfg.get("allowed_apps", DEFAULT_ALLOWED_APPS),
            cfg.get("blocked_patterns", DEFAULT_BLOCKED_PATTERNS),
            cfg.get("allowed_domains", DEFAULT_ALLOWED_DOMAINS),
            cfg.get("close_blocked_windows", True),
            blocked_notif_cache
        )

    try:
        while True:
            try:
                state_now = json.loads(STATE_FILE.read_text())
            except (OSError, ValueError):
                return
            if not state_now.get("active") or state_now.get("pid") != pid: return
            ends_at = state_now.get("ends_at", ends_at)
            time_left = ends_at - time.time()
            if time_left <= 0:
                duration_seconds = state_now.get("total_seconds", duration_seconds)
                break

            cfg = load_config()
            allowed_apps = cfg.get("allowed_apps", DEFAULT_ALLOWED_APPS)
            blocked_patterns = cfg.get("blocked_patterns", DEFAULT_BLOCKED_PATTERNS)
            blocked_binaries = cfg.get("blocked_binaries", DEFAULT_BLOCKED_BINARIES)
            allowed_domains = cfg.get("allowed_domains", DEFAULT_ALLOWED_DOMAINS)
            close_blocked = cfg.get("close_blocked_windows", True)

            # 1. Kill standalone distraction processes
            if session_type == "study" and time.time() - last_proc_check >= 2.0:
                last_proc_check = time.time()
                kill_forbidden_binaries(blocked_binaries)

            # 2. Window & Tab Enforcement
            if sock and session_type == "study":
                r, _, _ = select.select([sock], [], [], min(0.2, time_left))
                if r:
                    try:
                        data = sock.recv(4096).decode("utf-8", errors="ignore")
                        if data:
                            check_and_enforce_windows(allowed_apps, blocked_patterns, allowed_domains, close_blocked, blocked_notif_cache)
                    except Exception:
                        pass
            else:
                time.sleep(min(0.2, time_left))

            if time.time() - last_win_check >= 0.3 and session_type == "study":
                last_win_check = time.time()
                check_and_enforce_windows(allowed_apps, blocked_patterns, allowed_domains, close_blocked, blocked_notif_cache)

        if session_type == "study":
            record_session_completion(duration_seconds, label)
            record_completion_event(duration_seconds, label)
            notify("🎉 Study Session Complete!", f"Awesome job! Finished {label} ({formatted_time}). All restrictions lifted.", glyph="🎉")
            play_sound("complete")
            clear_state()
        else:
            cfg = load_config()
            default_mins = cfg.get("default_study_mins", 25)
            if paused_study and paused_study.get("remaining_seconds", 0) > 0:
                rem_secs = paused_study["remaining_seconds"]
                p_label = paused_study.get("label", "Study Session")
                notify("🔔 Break Finished!", f"Break complete! Resuming '{p_label}' ({format_time_remaining(rem_secs)} left).", glyph="🎯", urgency="critical")
                play_sound("break_start")
                # Seamlessly auto-resume the paused study session!
                start_session(rem_secs / 60.0, session_type="study", label=p_label)
                return
            else:
                notify("🔔 Break Finished!", f"Break complete! Resuming Study Focus ({default_mins}m).", glyph="🎯", urgency="critical")
                play_sound("break_start")
                # Seamlessly resume with default study session!
                start_session(default_mins, session_type="study", label="Pomodoro Focus")
                return

    finally:
        if sock:
            try:
                sock.close()
            except Exception:
                pass

def check_and_enforce_windows(allowed_apps, blocked_patterns, allowed_domains, close_blocked, notif_cache):
    windows = get_all_windows()
    now = time.time()

    for k in list(notif_cache.keys()):
        if now - notif_cache[k] > 6.0:
            del notif_cache[k]

    for win in windows:
        addr = win.get("address", "")
        w_class = win.get("class", "")
        w_init_class = win.get("initialClass", "")
        w_title = win.get("title", "")
        pid = win.get("pid")

        forbidden, reason, action_type = is_window_forbidden(w_class, w_init_class, w_title, allowed_apps, blocked_patterns, allowed_domains)

        if forbidden and close_blocked:
            app_key = w_title if action_type == "tab" else (w_class or w_init_class or str(pid))
            
            if app_key not in notif_cache:
                notif_cache[app_key] = now
                app_name = w_title or w_class or "Application"
                if len(app_name) > 35:
                    app_name = app_name[:32] + "..."
                msg = "Restricted tab detected; browser integration is required to close it." if action_type == "tab" else f"Blocked: '{app_name}' is restricted!"
                notify("⛔ Focus Restriction", msg, glyph="󰅶", urgency="critical")
                play_sound("blocked")

            enforce_close_tab_or_window(addr, action_type=action_type, pid=pid)

# ==============================================================================
# SESSION & MENU CONTROLS
# ==============================================================================

def start_session(minutes, session_type="study", label="Study Session", paused_study=None):
    current_state = load_raw_state()
    if session_type == "break" and not paused_study:
        if current_state and current_state.get("active") and current_state.get("type") == "study":
            rem = max(0, int(current_state.get("ends_at", 0) - time.time()))
            if rem > 0:
                paused_study = {
                    "remaining_seconds": rem,
                    "total_seconds": current_state.get("total_seconds", 1500),
                    "label": current_state.get("label", "Study Session"),
                    "started_at": current_state.get("started_at", time.time())
                }
        elif current_state and current_state.get("paused_study"):
            paused_study = current_state.get("paused_study")

    stop_existing_daemon(clear=False)
    seconds = int(float(minutes) * 60)
    
    script_path = os.path.abspath(__file__)
    cmd = [sys.executable, script_path, "daemon-exec", str(seconds), session_type, label]
    if paused_study:
        cmd.extend(["--paused-study", json.dumps(paused_study)])
    subprocess.Popen(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, preexec_fn=os.setpgrp)

def stop_existing_daemon(clear=True):
    my_pid = os.getpid()
    if PID_FILE.exists():
        try:
            with open(PID_FILE, "r") as f:
                pid = int(f.read().strip())
            if pid != my_pid:
                os.kill(pid, signal.SIGTERM)
                time.sleep(0.1)
        except Exception:
            pass
    if clear:
        clear_state(only_if_pid=my_pid)

def resume_study_session():
    current_state = load_raw_state()
    cfg = load_config()
    default_mins = cfg.get("default_study_mins", 25)
    if current_state and current_state.get("paused_study"):
        ps = current_state["paused_study"]
        rem_secs = ps.get("remaining_seconds", default_mins * 60)
        p_label = ps.get("label", "Study Session")
        notify("🎯 Focus Resumed", f"Back to '{p_label}' ({format_time_remaining(rem_secs)} remaining).", glyph="󰑴")
        start_session(rem_secs / 60.0, session_type="study", label=p_label)
    elif current_state and current_state.get("active") and current_state.get("type") == "break":
        notify("Starting Study Focus", f"Starting {default_mins}m Pomodoro Focus session.", glyph="󰑴")
        start_session(default_mins, session_type="study", label="Pomodoro Focus")
    else:
        start_session(default_mins, session_type="study", label="Pomodoro Focus")

def extend_session(minutes=10):
    state = load_state()
    if not state or not state.get("active"):
        notify("No Active Session", "There is no running study session to extend.", glyph="󰢌")
        return
    
    old_ends = state.get("ends_at", time.time())
    new_ends = old_ends + (minutes * 60)
    state["ends_at"] = new_ends
    state["total_seconds"] = state.get("total_seconds", 0) + (minutes * 60)
    save_state(state)
    
    remaining = format_time_remaining(new_ends - time.time())
    notify("⏳ Session Extended", f"+{minutes} mins added. Remaining: {remaining}", glyph="󰑴")

def menu_select(prompt, options, width=560, maxheight=520):
    cmd = ["omarchy-menu-select", prompt, "--", "--width", str(width), "--maxheight", str(maxheight)]
    try:
        p = subprocess.run(cmd, input="\n".join(options), text=True, capture_output=True)
        if p.returncode == 0:
            return p.stdout.strip()
    except Exception as e:
        print(f"Error invoking omarchy-menu-select: {e}", file=sys.stderr)
    return None

def menu_input(prompt, width=460):
    cmd = ["omarchy-menu-input", prompt, "--width", str(width)]
    try:
        p = subprocess.run(cmd, text=True, capture_output=True)
        if p.returncode == 0:
            return p.stdout.strip()
    except Exception as e:
        print(f"Error invoking omarchy-menu-input: {e}", file=sys.stderr)
    return None

def add_allowed_app(pattern):
    pattern = pattern.strip()
    if not pattern:
        return
    cfg = load_config()
    clean = pattern.lower().replace("*", "").strip()
    norm_clean = normalize_app_str(pattern)
    if pattern not in cfg["allowed_apps"]:
        cfg["allowed_apps"].append(pattern)
    # Remove from blocked_binaries and blocked_patterns to prevent conflict
    cfg["blocked_binaries"] = [b for b in cfg.get("blocked_binaries", [])
                               if normalize_app_str(b) != norm_clean
                               and norm_clean not in normalize_app_str(b)
                               and normalize_app_str(b) not in norm_clean]
    cfg["blocked_patterns"] = [p for p in cfg.get("blocked_patterns", [])
                               if normalize_app_str(p) != norm_clean
                               and norm_clean not in normalize_app_str(p)
                               and normalize_app_str(p) not in norm_clean]
    save_config(cfg)
    notify("App Permitted", f"Added '{pattern}' to allowed apps list.", glyph="󰄬")

def remove_allowed_app(pattern):
    cfg = load_config()
    if pattern in cfg["allowed_apps"]:
        cfg["allowed_apps"].remove(pattern)
        save_config(cfg)
        notify("App Removed", f"Removed '{pattern}' from allowed apps.", glyph="󰭌")

def add_allowed_domain(domain):
    domain = domain.strip().lower()
    if not domain:
        return
    cfg = load_config()
    if domain not in cfg["allowed_domains"]:
        cfg["allowed_domains"].append(domain)
    # Clean from blocked_domains and blocked_patterns
    keywords = get_domain_keywords(domain)
    cfg["blocked_domains"] = [d for d in cfg.get("blocked_domains", [])
                              if d.lower().strip() not in keywords and not any(kw in d.lower() for kw in keywords)]
    cfg["blocked_patterns"] = [p for p in cfg.get("blocked_patterns", [])
                               if p.lower().replace("*", "").strip() not in keywords]
    save_config(cfg)
    notify("Website Permitted", f"Added '{domain}' to Permitted Websites.", glyph="󰄬")

def remove_allowed_domain(domain):
    cfg = load_config()
    if domain in cfg["allowed_domains"]:
        cfg["allowed_domains"].remove(domain)
        save_config(cfg)
        notify("Website Removed", f"Removed '{domain}' from Permitted Websites.", glyph="󰭌")

def add_blocked_domain(domain):
    domain = domain.strip().lower()
    if not domain:
        return
    cfg = load_config()
    if domain not in cfg["blocked_domains"]:
        cfg["blocked_domains"].append(domain)
        save_config(cfg)
        notify("Website Blacklisted", f"Added '{domain}' to Restricted Websites.", glyph="󰄬")

def remove_blocked_domain(domain):
    cfg = load_config()
    if domain in cfg["blocked_domains"]:
        cfg["blocked_domains"].remove(domain)
        save_config(cfg)
        notify("Website Unblocked", f"Removed '{domain}' from Restricted Websites.", glyph="󰭌")

def allow_current_window():
    win = get_active_window()
    if not win:
        notify("No Active Window", "Could not detect active window to allow.", glyph="󰢌")
        return
    w_class = win.get("class") or win.get("initialClass")
    pid = win.get("pid")
    comm = get_process_comm(pid) if pid else ""
    if w_class:
        add_allowed_app(w_class)
        if comm and comm.lower() != w_class.lower() and comm not in IMMUNE_PROCESSES:
            add_allowed_app(comm)
    else:
        notify("Unable to Identify", "Active window does not have a valid class name.", glyph="󰢌")

def manage_allowed_apps_menu():
    while True:
        cfg = load_config()
        allowed = cfg.get("allowed_apps", [])
        
        options = [
            "󰐊\t➕ Allow Currently Focused App\tAdd active window to whitelist",
            "󰏫\t➕ Add Custom App Pattern...\tType a pattern like 'vlc*' or 'zoom*'",
            "󰭌\t➖ Remove an Allowed App\tSelect an app to remove from whitelist",
            "\t🔄 Reset Allowed Apps to Default\tRestore standard study apps list",
            "󰌌\t📋 View All Allowed Apps\tDisplay complete permitted list",
            "󰌑\t↩ Back to Main Menu\tReturn to focus options"
        ]
        
        sel = menu_select("Manage Allowed Study Apps", options, width=560)
        if not sel:
            break
            
        action = sel.split("\t")[0]
        if "➕ Allow Currently Focused App" in action:
            allow_current_window()
        elif "➕ Add Custom App Pattern" in action:
            pat = menu_input("Enter app name or pattern to allow:", width=520)
            if pat:
                add_allowed_app(pat)
        elif "➖ Remove an Allowed App" in action:
            if not allowed:
                notify("Empty List", "Allowed apps list is empty.", glyph="󰢌")
                continue
            rem_options = [f"󰭌\t{app}\tRemove this application" for app in allowed]
            rem_options.append("󰌑\tCancel\tDo not remove anything")
            rem_sel = menu_select("Select App to Remove", rem_options, width=540)
            if rem_sel and not "Cancel" in rem_sel:
                app_to_remove = rem_sel.split("\t")[0]
                remove_allowed_app(app_to_remove)
        elif "🔄 Reset Allowed Apps to Default" in action:
            cfg["allowed_apps"] = DEFAULT_ALLOWED_APPS.copy()
            save_config(cfg)
            notify("List Reset", "Allowed apps reset to default study tools.", glyph="󰄬")
        elif "📋 View All Allowed Apps" in action:
            view_options = [f"󰄬\t{app}\tPermitted in study mode" for app in allowed]
            view_options.append("󰌑\tClose\tDismiss list")
            menu_select("Permitted Study Apps", view_options, width=540)
        elif "↩ Back to Main Menu" in action:
            break

